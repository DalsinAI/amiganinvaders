# nInvaders for GFOS (AmigaOS 3.2 with GFOpenUp), 68040/68060: Space
# Invaders in its own 80 x 24 console window, in colour, built soft float
# (the stove's fpuauto uses the FPU when the Amiga has one). No SDL, no
# ACGame, no GFOpenGPU.
#
#   make -f amiga/Makefile.amigaos -j4 UP=/path/to/ninvaders-0.1.1 [STOVE=...]
#
# UP is upstream's tarball as package/ninvaders.lock names it, with
# amiga/patches applied (package/build-amiga.sh does both). STOVE is a
# GFOpenAmigaGCC 16.2.0-open6 stove (prefix/ has the compiler and the NDK).
# The game draws through amiga/curses.c (the part of ncurses it uses, sent
# to the console as ANSI with the eight pens for colour: the same layer as
# DalsinAI/amiga2048's, with pads and copywin for this game);
# amiga/console_amiga.c opens the window and reads the keys (amiga/keys.c:
# the cursor keys as KEY_*).
#
# Output: build/amigaos/nInvaders/ (the drawer: nInvaders, ReadMe, the
# licence, GlowIcons), build/amigaos/nInvaders.info and Install-nInvaders
# beside them.

UP      ?= ../ninvaders-0.1.1
STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16-open6
PREFIX  ?= $(STOVE)/prefix
CC      = $(PREFIX)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -msoft-float
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile.
OPT     ?= -Os -fomit-frame-pointer -fno-tree-loop-distribute-patterns

# -fcommon: upstream defines its globals in its headers (tentative definitions)
UPFLAGS = -noixemul $(OPT) $(CPU) -std=gnu11 -fcommon -D__amigaos__ -w \
          -Werror=implicit-function-declaration -Iamiga/include -Iamiga -I$(UP)
MYFLAGS = -noixemul $(OPT) $(CPU) -std=gnu99 -Wall -Iamiga/include -Iamiga \
          -DAMIGA_GAME_TITLE='"nInvaders"'
LDFLAGS = -noixemul $(CPU)

BUILD   = build/amigaos
OBJ     = $(BUILD)/obj
OUT     = $(BUILD)/nInvaders

GAME    = globals view aliens ufo player nInvaders
PORT    = curses keys console_amiga

all: $(OUT)/nInvaders package

$(OBJ)/up/%.o: $(UP)/%.c $(wildcard amiga/include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(UPFLAGS) -c -o $@ $<

$(OBJ)/port/%.o: amiga/%.c $(wildcard amiga/*.h amiga/include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(MYFLAGS) -c -o $@ $<

$(OUT)/nInvaders: $(GAME:%=$(OBJ)/up/%.o) $(PORT:%=$(OBJ)/port/%.o)
	@mkdir -p $(OUT)
	$(CC) $(LDFLAGS) -o $@ $^

package: $(OUT)/nInvaders AMIGA_PORT.md
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp $(UP)/gpl.txt $(OUT)/COPYING.txt
	cp amiga/icons/nInvaders.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/COPYING.txt.info
	cp amiga/icons/nInvaders-drawer.info $(BUILD)/nInvaders.info
	cp amiga/Install-nInvaders amiga/Install-nInvaders.info $(BUILD)/

clean:
	rm -rf $(BUILD)

.PHONY: all package clean
